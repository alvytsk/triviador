{
  "$defs": {
    "AcquisitionKind": {
      "enum": [
        "claimed",
        "conquest",
        "base"
      ],
      "title": "AcquisitionKind",
      "type": "string"
    },
    "ApiErrorCode": {
      "description": "Every value here and every value in `RejectCode` share one namespace.\nThe four `RuntimeCode` values are repeated verbatim rather than\nimported, so this enum is the single closed list codegen exports; a\ntest asserts the two sets agree.",
      "enum": [
        "validation_failed",
        "unauthenticated",
        "forbidden",
        "not_found",
        "method_not_allowed",
        "payload_too_large",
        "credentials_invalid",
        "invite_invalid",
        "username_taken",
        "map_unknown",
        "preset_unknown",
        "media_rejected",
        "slug_taken",
        "no_default_preset",
        "server_busy",
        "server_restarting",
        "game_recovering",
        "game_unrecoverable",
        "database_unavailable",
        "internal_error"
      ],
      "title": "ApiErrorCode",
      "type": "string"
    },
    "ClientChoice": {
      "additionalProperties": false,
      "description": "No `is_correct`. \u00a712.3 rejects byte-scanning as the test for this,\nbecause the correct answer's *text* is legitimate content \u2014 so the\nguarantee has to be that the flag has nowhere to live.",
      "properties": {
        "idx": {
          "title": "Idx",
          "type": "integer"
        },
        "media_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Url"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "idx",
        "text"
      ],
      "title": "ClientChoice",
      "type": "object"
    },
    "ClientGameState": {
      "additionalProperties": false,
      "properties": {
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "map_id": {
          "title": "Map Id",
          "type": "string"
        },
        "media_prefetch": {
          "items": {
            "type": "string"
          },
          "title": "Media Prefetch",
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/ClientPlayer"
          },
          "title": "Players",
          "type": "array"
        },
        "round_no": {
          "title": "Round No",
          "type": "integer"
        },
        "rules": {
          "$ref": "#/$defs/ClientRules"
        },
        "territories": {
          "items": {
            "$ref": "#/$defs/ClientTerritory"
          },
          "title": "Territories",
          "type": "array"
        },
        "turn": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "battle_duel": "#/$defs/DuelTurn",
                  "battle_target_select": "#/$defs/TargetSelectTurn",
                  "expansion_picking": "#/$defs/PickingTurn",
                  "expansion_question": "#/$defs/QuestionTurn",
                  "final_tiebreak": "#/$defs/FinalTurn",
                  "media_warmup": "#/$defs/WarmupTurn",
                  "neutral_challenge": "#/$defs/NeutralTurn"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/WarmupTurn"
                },
                {
                  "$ref": "#/$defs/QuestionTurn"
                },
                {
                  "$ref": "#/$defs/PickingTurn"
                },
                {
                  "$ref": "#/$defs/TargetSelectTurn"
                },
                {
                  "$ref": "#/$defs/DuelTurn"
                },
                {
                  "$ref": "#/$defs/NeutralTurn"
                },
                {
                  "$ref": "#/$defs/FinalTurn"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn"
        },
        "turn_order": {
          "items": {
            "type": "string"
          },
          "title": "Turn Order",
          "type": "array"
        },
        "winner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Winner Id"
        },
        "you": {
          "$ref": "#/$defs/ClientYou"
        }
      },
      "required": [
        "game_id",
        "map_id",
        "phase",
        "round_no",
        "rules",
        "turn_order",
        "players",
        "territories",
        "turn",
        "winner_id",
        "media_prefetch",
        "you"

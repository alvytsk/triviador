    "DuelTurn": {
      "additionalProperties": false,
      "description": "`BattleDuel` and `BattleTiebreak` share this shape; `tiebreak`\ndistinguishes them. Two models would be two identical field lists and\ntwo Zod schemas for one screen.",
      "properties": {
        "answered": {
          "items": {
            "type": "string"
          },
          "title": "Answered",
          "type": "array"
        },
        "attacker_id": {
          "title": "Attacker Id",
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "deadline_id": {
          "title": "Deadline Id",
          "type": "integer"
        },
        "defender_id": {
          "title": "Defender Id",
          "type": "string"
        },
        "kind": {
          "const": "battle_duel",
          "default": "battle_duel",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/ClientQuestion"
        },
        "region_id": {
          "title": "Region Id",
          "type": "string"
        },
        "tiebreak": {
          "title": "Tiebreak",
          "type": "boolean"
        },
        "your_answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubmittedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "your_options": {
          "$ref": "#/$defs/YourOptions",
          "default": {
            "attack": [],
            "pick": []
          }
        }
      },
      "required": [
        "deadline_id",
        "deadline_at",
        "tiebreak",
        "attacker_id",
        "defender_id",
        "region_id",
        "question",
        "answered"
      ],
      "title": "DuelTurn",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "description": "`code` is a closed union of two disjoint enums.\n\n`ApiErrorCode` is \"the server could not, or would not, do this\";\n`RejectCode` is \"the domain refused this command\". Keeping both in one\nfield means a client switches once. `test_envelope.py` asserts the two\nvalue sets never overlap.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiErrorCode"
            },
            {
              "$ref": "#/$defs/RejectCode"
            }
          ],
          "title": "Code"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },

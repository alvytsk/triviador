# Copy to .env (mode 0600) and replace every CHANGE_ME.
TRIVIADOR_DATABASE_URL=postgresql+asyncpg://triviador:CHANGE_ME@db:5432/triviador
# Prod-shaped defaults: Caddy (§10.2) is the only published port, and it
# listens on :80, so a deploy that never touches these two lines already
# works for a browser on the SAME machine (http://localhost). Both are
# exact-match, not a pattern — `origin_allowed` (api/middleware.py) and
# `HostMiddleware` compare the literal string, and `HostMiddleware` compares
# the Host header with its port already stripped. For a real LAN deploy,
# ADD (do not replace) the LAN address to BOTH, in the exact shapes below,
# or every POST 403s and the WS handshake is refused even though
# `/api/health/ready` reports true:
#   TRIVIADOR_ALLOWED_ORIGINS=http://localhost,http://192.168.1.50
#   TRIVIADOR_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
# `ALLOWED_ORIGINS` needs the scheme (`http://`) because it is matched
# against the browser's `Origin` header; `ALLOWED_HOSTS` must NOT have one,
# because it is matched against `Host` with the port already stripped.
TRIVIADOR_ALLOWED_ORIGINS=http://localhost
TRIVIADOR_ALLOWED_HOSTS=localhost,127.0.0.1
TRIVIADOR_COOKIE_SECURE=false
TRIVIADOR_SESSION_TTL_DAYS=30
TRIVIADOR_MAPS_ROOT=/data/maps
TRIVIADOR_MEDIA_PUBLIC_BASE=/media
TRIVIADOR_LOG_LEVEL=INFO
TRIVIADOR_LOG_FORMAT=json
TRIVIADOR_S3_ENDPOINT_URL=http://garage:3900
TRIVIADOR_S3_REGION=garage
# Garage enforces both formats below (`garage key import` fails outright
# otherwise — verified against dxflrs/garage:v1.1.0): the access key ID
# must be "GK" followed by 24 hex characters (12 hex-encoded bytes), and
# the secret must be exactly 64 hex characters (32 hex-encoded bytes).
# `openssl rand -hex 12` / `openssl rand -hex 32` produce values in the
# right shape.
TRIVIADOR_S3_ACCESS_KEY_ID=CHANGE_ME
TRIVIADOR_S3_SECRET_ACCESS_KEY=CHANGE_ME
TRIVIADOR_MEDIA_BUCKET=triviador-media
TRIVIADOR_STAGING_BUCKET=triviador-staging
TRIVIADOR_IMPORT_TTL_HOURS=24
# Optional. `infra/garage/init.sh`'s `garage layout assign -c` value — how
# much of the single node's disk Garage is told it may use, NOT a hard
# quota this repo enforces elsewhere. "1G" is not valid (B/KB/MB/GB/TB/PB
# only). Uncomment and change only if the default is wrong for this host;
# leaving it unset uses init.sh's own 100GB default.
# TRIVIADOR_GARAGE_CAPACITY=100GB
# Read by Compose itself (not by the backend): substituted into
# compose.yaml for the database password and rendered into Garage's
# rpc_secret_file before launch. They live here rather than in a second
# file so `startup_problems` covers them from the first deploy.
POSTGRES_PASSWORD=CHANGE_ME
GARAGE_RPC_SECRET=CHANGE_ME
# §10.8's backup destination — a Windows disk, external drive, or NAS
# path, NEVER inside the WSL vhdx (that vhdx *is* the thing being backed
# up; single-node Garage has replication_factor = 1, so this copy is the
# only redundancy in the system). Only read by `docker compose --profile
# backup run --rm backup`; the plain stack never touches it.
BACKUP_DEST=CHANGE_ME
